{
	"name": "teeline.online",
	"version": "0.0.1",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "npm run format && npm run lint && npm run test && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check --plugin prettier-plugin-svelte .",
		"format": "prettier --write --plugin prettier-plugin-svelte .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tsconfig/svelte": "^5.0.9",
		"@typescript-eslint/eslint-plugin": "8.72.2",
		"@typescript-eslint/parser": "8.72.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"mdsvex": "^0.12.8",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-preprocess": "^6.0.5",
		"typescript": "~6.0.3",
		"vitest": "^5.1.0"
	},
	"type": "module",
	"dependencies": {
		"vite": "^8.3.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
